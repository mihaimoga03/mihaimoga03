# Cheia de API Anthropic. Alternativ, ruleaza `ant auth login` si lasa variabila nesetata.
ANTHROPIC_API_KEY=sk-ant-...

# Optionale - valorile de mai jos sunt cele implicite.
GESTIO_MODEL=claude-opus-5
GESTIO_DB=gestio.db
GESTIO_VAT_RATE=21
GESTIO_PAYMENT_TERMS=30
GESTIO_INVOICE_SERIES=FACT
GESTIO_COMPANY=Firma mea SRL
GESTIO_CURRENCY=RON
GESTIO_EFFORT=high
GESTIO_MAX_TOKENS=16000
GESTIO_MAX_ITERATIONS=40
