# Se pun în Cloudflare → Workers & Pages → proiect → Settings → Variables and Secrets.
# Toate sunt opționale: fără ele, linkurile merg la magazin fără ID de afiliat.

# Amazon Associates — un tag pe marketplace (sau AMAZON_TAG pentru toate)
AMAZON_TAG=
AMAZON_TAG_DE=
AMAZON_TAG_GB=
AMAZON_TAG_US=

# eBay Partner Network — Campaign ID din contul EPN
EBAY_CAMPAIGN_ID=

# Rețele cu deep link (Profitshare, 2Performant, AliExpress Portals, Temu).
# {url} = adresa magazinului (codată), {src} = sursa vizitatorului (ig, tiktok, fb… sau „site”).
# Exemplu 2Performant:
#   https://event.2performant.com/events/click?ad_type=quicklink&aff_code=CODUL_TAU&unique=ID_PROGRAM&redirect_to={url}&st={src}
AFF_TEMPLATE_EMAG=
AFF_TEMPLATE_PCG=
AFF_TEMPLATE_ALI=
AFF_TEMPLATE_TEMU=
