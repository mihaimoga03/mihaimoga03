# Toate sunt opționale. Fără ele, /go redirecționează la magazin fără ID de afiliat.

# Amazon Associates — un tag pe marketplace (sau AMAZON_TAG pentru toate)
AMAZON_TAG=
AMAZON_TAG_DE=
AMAZON_TAG_GB=
AMAZON_TAG_US=

# eBay Partner Network — Campaign ID din contul EPN
EBAY_CAMPAIGN_ID=

# Rețele cu deep link (Profitshare, 2Performant, AliExpress Portals, Temu).
# Șablon de URL în care {url} este înlocuit cu adresa magazinului, codată.
# Exemplu 2Performant:
#   https://event.2performant.com/events/click?ad_type=quicklink&aff_code=CODUL_TAU&unique=ID_PROGRAM&redirect_to={url}
AFF_TEMPLATE_EMAG=
AFF_TEMPLATE_PCG=
AFF_TEMPLATE_ALI=
AFF_TEMPLATE_TEMU=

# Înregistrarea click-urilor în Supabase (tabelul din supabase/clicks.sql)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
